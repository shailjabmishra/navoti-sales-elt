{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly sales trend with the two highest months annotated. Fields: DIM_DATE[YEAR_MONTH], [Sales Amount (Trend)]",
  "data": {"name": "dataset"},
  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "transform": [
    {"calculate": "toDate(datum['YEAR_MONTH'] + '-01')", "as": "month"},
    {"calculate": "datum['Sales Amount (Trend)']", "as": "sales"},
    {"window": [{"op": "row_number", "as": "rank"}], "sort": [{"field": "sales", "order": "descending"}]},
    {"calculate": "timeFormat(datum.month, '%b %Y') + '  ' + format(datum.sales, '.3s')", "as": "label"}
  ],
  "encoding": {
    "x": {
      "field": "month", "type": "temporal",
      "axis": {"title": null, "format": "%Y", "tickCount": "year", "grid": false, "domainColor": "#C8C6C4", "labelColor": "#605E5C", "labelFontSize": 11}
    },
    "y": {
      "field": "sales", "type": "quantitative",
      "axis": {"title": null, "format": "~s", "tickCount": 4, "gridColor": "#EDEBE9", "domain": false, "ticks": false, "labelColor": "#605E5C", "labelFontSize": 11}
    }
  },
  "layer": [
    {"mark": {"type": "area", "color": "#2A78D6", "opacity": 0.12, "interpolate": "linear"}},
    {"mark": {"type": "line", "color": "#2A78D6", "strokeWidth": 2, "interpolate": "linear", "strokeCap": "round"}},
    {
      "transform": [{"filter": "datum.rank <= 2"}],
      "mark": {"type": "point", "filled": true, "size": 80, "color": "#EB6834", "stroke": "white", "strokeWidth": 2}
    },
    {
      "transform": [{"filter": "datum.rank <= 2"}],
      "mark": {"type": "text", "dy": -14, "fontSize": 11, "fontWeight": "bold", "color": "#B5431B"},
      "encoding": {"text": {"field": "label"}}
    },
    {
      "mark": {"type": "point", "size": 120, "opacity": 0},
      "encoding": {
        "tooltip": [
          {"field": "month", "type": "temporal", "title": "Month", "format": "%B %Y"},
          {"field": "sales", "type": "quantitative", "title": "Sales", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}, "font": "Segoe UI"}
}
